#!/usr/bin/env python3
"""yt-pubx — publica um vídeo direto no YouTube, com título, descrição, tags e thumb.

  yt-pubx init                                   cria ~/.config/yt-pubx/config.json
  yt-pubx auth <canal> --client-secret arq.json  autoriza um canal (OAuth, uma vez)
  yt-pubx canais                                 lista os canais configurados
  yt-pubx publicar <arquivo|URL> [--canal X] [opções]
  yt-pubx atualizar <id|URL> [--description-arquivo X] edita um vídeo já publicado

Sem --title/--description, o Codex CLI escreve título, descrição, tags, frase e cena
da thumb a partir de --contexto / --contexto-arquivo / --legenda. A arte da thumb sai
do gerador de imagem do Codex (image_gen); um servidor de imagem local é reserva opcional.
"""
import argparse, base64, glob, hashlib, http.server, io, json, os, re, secrets
import shlex, subprocess, sys, tempfile, threading, time, urllib.parse, webbrowser
from datetime import datetime

VERSION = '2.3.0'
CONFIG_DIR = os.path.expanduser(os.environ.get('YTPUBX_CONFIG', '~/.config/yt-pubx'))
CONFIG = os.path.join(CONFIG_DIR, 'config.json')
DATA_DIR = os.path.expanduser(os.environ.get('YTPUBX_DATA', '~/.local/share/yt-pubx'))
TRABALHOS = os.path.join(DATA_DIR, 'trabalhos')
HISTORICO = os.path.join(DATA_DIR, 'historico.jsonl')
SCOPES = ['https://www.googleapis.com/auth/youtube.upload',
          'https://www.googleapis.com/auth/youtube',
          'https://www.googleapis.com/auth/youtube.force-ssl']
CHUNK = 16 * 1024 * 1024
THUMB_MAX = 2 * 1024 * 1024
W, H = 1280, 720

EXEMPLO = {
    'canal_padrao': 'principal',
    'codex_modelo': '',
    'baixador': 'yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b" -o "{outdir}/%(title).80s.%(ext)s" {url}',
    'imagem_reserva': {'url': '', 'modelo': ''},
    'canais': {
        'principal': {
            'nome': 'Meu Canal',
            'url': 'https://www.youtube.com/@meucanal',
            'sobre': 'Canal de tutoriais sobre ...',
